# OpenAI-compatible provider config.
# Copy this file to .env and fill in your own keys.
# .env is gitignored and will never be committed.

MOMENTUM_API_KEY=your-api-key-here
MOMENTUM_BASE_URL=https://api.deepseek.com
MOMENTUM_MODEL=deepseek-v4-flash

# Optional: disable tracing for third-party compatible endpoints.
MOMENTUM_DISABLE_TRACING=true

# Optional: DeepSeek V4 / DSV4 Flash thinking mode.
MOMENTUM_THINKING=enabled
MOMENTUM_REASONING_EFFORT=high

# Optional: log level (DEBUG for verbose, INFO default)
# MOMENTUM_LOG_LEVEL=DEBUG

# Optional: user identifier for data isolation
# MOMENTUM_USER=default
