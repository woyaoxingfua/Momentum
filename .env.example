# OpenAI-compatible provider config.
# Copy this file to .env and fill in your own keys.
# .env is gitignored and will never be committed.

MOMENTUM_API_KEY=your-api-key-here
MOMENTUM_BASE_URL=https://api.deepseek.com
# DeepSeek V4 Flash supports vision if you use V4 model
MOMENTUM_MODEL=deepseek-v4-flash
# Alternative models with vision support:
# - gpt-4o (OpenAI)
# - gpt-4o-mini (OpenAI)
# - claude-3-5-sonnet-20241022 (Anthropic via compatible endpoint)
# - deepseek-v4 (DeepSeek with vision)

# Optional: disable tracing for third-party compatible endpoints.
MOMENTUM_DISABLE_TRACING=true

# Optional: DeepSeek V4 / DSV4 Flash thinking mode.
MOMENTUM_THINKING=enabled
MOMENTUM_REASONING_EFFORT=high

# Logging — 默认已启用文件日志（写入 logs/ 目录），无需手动配置
# 如需调整级别：
# MOMENTUM_LOG_LEVEL=DEBUG

# 如需指定日志文件路径（覆盖默认按日期命名）：
# MOMENTUM_LOG_FILE=logs/momentum.log

# 如需指定日志目录（默认 logs/）：
# MOMENTUM_LOG_DIR=logs

# 如需禁用文件日志：
# MOMENTUM_LOG_FILE=off

# 单个日志文件最大字节数（默认 10MB）：
# MOMENTUM_LOG_MAX_BYTES=10485760

# 保留的历史日志文件数量（默认 5）：
# MOMENTUM_LOG_BACKUPS=5

# Optional: user identifier for data isolation
# MOMENTUM_USER=default
