# ============================================
# Momentum Task Agent - 环境配置示例
# ============================================
# ⚠️  重要安全提醒：
# 1. 复制此文件为 .env，并添加到 .gitignore
# 2. 永远不要将真实的 .env 文件提交到 Git
# 3. 打包发布时，确保不包含 .env 文件
# ============================================

# API 配置（可选，不填也能运行基础功能）
MOMENTUM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MOMENTUM_API_BASE=https://api.deepseek.com
MOMENTUM_MODEL=deepseek-chat

# 日志配置（可选）
MOMENTUM_LOG_LEVEL=INFO

# 数据库路径（可选，默认 .momentum/tasks.db）
MOMENTUM_DB_PATH=.momentum/tasks.db

# MCP Server 鉴权（可选，仅 SSE 模式生效；不设置则不鉴权）
# MOMENTUM_MCP_API_KEY=your-secret-key
