# ============================================
# Momentum Task Agent - 环境配置示例
# ============================================
# ⚠️  重要安全提醒：
# 1. 复制此文件为 .env，并添加到 .gitignore（.env 已被忽略）
# 2. 永远不要将真实的 .env 文件提交到 Git
# 3. 打包发布时，确保不包含 .env 文件
#
# 💡 推荐用法：
#   运行 `momentum-agent init` 启动配置向导，
#   交互式完成全部配置，自动生成 .env 和 momentum.config.json。
#   本文件仅作参考，无需手动编辑。
# ============================================

# ── 数据库（启动级）────────────────────────────────
# 支持 sqlite:///path/to/db.db / mysql://user:pass@host:port/db / azure://user:pass@host:port/db
# 不设置则默认 .momentum/tasks.db
MOMENTUM_DATABASE_URL=mysql://user:password@localhost:3306/momentum

# 当前操作的目标用户 ID（多租户场景用，默认 default）
# MOMENTUM_USER=default

# ── AI Provider（启动级，但可被 DB 用户偏好覆盖）────
# 三选一：留空走 DB 偏好；填值则全局生效
MOMENTUM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 注意变量名是 MOMENTUM_BASE_URL（不是 MOMENTUM_API_BASE）
MOMENTUM_BASE_URL=https://api.deepseek.com/v1
MOMENTUM_MODEL=deepseek-chat
# 显式指定 provider：openai / ollama（留空则自动推断）
# MOMENTUM_PROVIDER=openai

# 关闭 agents SDK 链路追踪（使用自定义 base_url 时建议开启）
# MOMENTUM_DISABLE_TRACING=true

# 思考模式：enabled / disabled
# MOMENTUM_THINKING=disabled

# 推理强度：minimal / low / medium / high
# MOMENTUM_REASONING_EFFORT=medium

# ── 日志（启动级）──────────────────────────────────
MOMENTUM_LOG_LEVEL=INFO
# 日志目录，设为 off 关闭文件日志
MOMENTUM_LOG_DIR=logs
# 日志文件路径，设为 off 关闭；留空则按日期 momentum-YYYY-MM-DD.log
# MOMENTUM_LOG_FILE=
# 单个日志文件最大字节数（默认 10MB）
# MOMENTUM_LOG_MAX_BYTES=10485760
# 日志轮转保留的备份文件数
# MOMENTUM_LOG_BACKUPS=5

# ── Web 服务（启动级，可被 momentum.config.json 覆盖）──
# 留空则用 momentum.config.json 或硬编码默认 127.0.0.1:8765
# MOMENTUM_WEB_HOST=127.0.0.1
# MOMENTUM_WEB_PORT=8765

# ── MCP Server（启动级）─────────────────────────────
# SSE 模式的监听地址/端口（可被 momentum.config.json 覆盖）
# MOMENTUM_MCP_HOST=127.0.0.1
# MOMENTUM_MCP_PORT=8766
# SSE 模式的 API Key 鉴权（不设置则不鉴权；stdio 模式不鉴权）
# MOMENTUM_MCP_API_KEY=your-secret-key
